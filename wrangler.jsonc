{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arklow-docs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "route": {
    "pattern": "docs.arklow.io/*",
    "zone_name": "arklow.io"
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
